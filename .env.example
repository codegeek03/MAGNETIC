# ── Infrastructure ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/packaging_db

# ── LLM API Keys ────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
